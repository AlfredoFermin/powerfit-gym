APP_NAME="PowerFit Gym"
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Santo_Domingo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Conexión a la base de datos existente (Actividad 2). Sin migraciones.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=powerfit_gym
DB_USERNAME=powerfit
DB_PASSWORD=CAMBIAR_ESTA_CLAVE

# Los usuarios se autentican contra la tabla `usuarios`.
AUTH_MODEL='App\Models\Usuario'

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
BCRYPT_ROUNDS=12
